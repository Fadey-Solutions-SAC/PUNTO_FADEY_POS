{
  "name": "punto-fadey",
  "version": "1.0.3.6",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "node --import tsx server/app.ts",
    "dev:vite": "npm run dev --prefix client",
    "dev:stack": "concurrently -n api,vite -c teal,magenta \"npm run dev:api\" \"npm run dev:vite\"",
    "build": "next build --webpack",
    "build:vite": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "next start",
    "start:server": "node scripts/boot.mjs",
    "start:api": "node --import tsx server/app.ts",
    "lint": "eslint",
    "db:push": "prisma db push",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "express": "^4.22.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
